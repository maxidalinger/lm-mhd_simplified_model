c#include <my_gfldr.f>
c-----------------------------------------------------------------------
c   
c   The domain consists of two plates of finite thickness (h=0.5) 
c   with plane Poiseiulle flow moving between the plates from left 
c   to right (x=0 to 8).
c   
c   The gap height is 1.0 (y=0 to 1).
c   
c   The flow inlet temperature is T=0 and the plates are heated
c   with volumetric heat source, qvol = 1.
c
c   Insulated boundary conditions are applied on the solid
c   surfaces that are not interior to the computational domain,
c   so heat leaves only through advection at the flow outlet.
c
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux   = 0.01
      uy   = 0.01
      uz   = 0.01
      temp = 0.01

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat0
      include 'SIZE'

      integer hscale, debug_setup
      common /my_idata/ hscale, debug_setup
      real Dp_pbli
      common /my_rdata/ Dp_pbli
      integer etag
      common /my_etag/ etag(lelt)

      call nekrs_registerPtr('debug_setup', debug_setup)
      call nekrs_registerPtr('hscale', hscale)
      call nekrs_registerPtr('dp_pbli', Dp_pbli)
      call nekrs_registerPtr('etag', etag) ! filled in usrdat2, read by udf

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      include 'SIZE'
      include 'TOTAL'
 
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      integer hscale, debug_setup
      common /my_idata/ hscale, debug_setup
      real Dp_pbli
      common /my_rdata/ Dp_pbli

      real scaling_factor

      integer ntot
      integer etag
      common /my_etag/ etag(lelt)

      logical rotate_vel
      real x1,x2,x3

      ntot = lx1*ly1*lz1*nelt

c-----------------------------------------------------------------------
c Rescale domain using diameter of the PbLi inlet
c-----------------------------------------------------------------------
      call chk_domain_minmax('aaa')
      scaling_factor = 1.0/Dp_pbli
      if (nio.eq.0) write(*,*) 'chk-dp',Dp_pbli,scaling_factor

      call cmult(xm1,scaling_factor,ntot)
      call cmult(ym1,scaling_factor,ntot)
      call cmult(zm1,scaling_factor,ntot)
      call fix_geom
      call geom_reset(2)

      call chk_domain_minmax('bbb')

c-----------------------------------------------------------------------
c Assign boundary IDs based on global element number ieg = lglel(iel)
c mesh info is also used to distinguish FW water inlet and DWT water inlet
c-----------------------------------------------------------------------
      call my_cbc_chk('bbb')
      call my_bdid_chk('bbb')

      call setup_etag_bc(etag)

      call my_cbc_chk('ccc')
      call my_bdid_chk('ccc')

c-----------------------------------------------------------------------
c Rotate Mesh
c-----------------------------------------------------------------------
      ifld=1
      call get_surface_normal(ifld,1,x1,x2,x3,'ccc v1') ! 3 inlets
      call get_surface_normal(ifld,2,x1,x2,x3,'ccc v2')
      call get_surface_normal(ifld,3,x1,x2,x3,'ccc v3')
      call get_surface_normal(ifld,4,x1,x2,x3,'ccc v4')
      call get_surface_normal(ifld,5,x1,x2,x3,'ccc O5') ! 2 outlets
      call get_surface_normal(ifld,6,x1,x2,x3,'ccc O6')
      call get_surface_normal(ifld,7,x1,x2,x3,'ccc O7')

c      rotate_vel = .false.
c      call rotate_mesh_aux(1,2,rotate_vel) ! TODO need careful choice, on axis, x- and x+
c      call recenter_mesh(etag,2)

      if (debug_setup.gt.0) call dump_etag_bc_surface(etag,'ddd')
      call chk_domain_etag_minmax(etag,'ddd')
      call chk_domain_etag_volume(etag,'ddd')
      call chk_domain_minmax('ddd')

c      ifld=1
c      call get_surface_normal(ifld,1,x1,x2,x3,'ddd v1')
c      call get_surface_normal(ifld,2,x1,x2,x3,'ddd v2')
c      call get_surface_normal(ifld,3,x1,x2,x3,'ddd v3')
c      call get_surface_normal(ifld,4,x1,x2,x3,'ddd v4') 
c      call get_surface_normal(ifld,5,x1,x2,x3,'ddd O5') 
c      call get_surface_normal(ifld,6,x1,x2,x3,'ddd O6') 
c      call get_surface_normal(ifld,7,x1,x2,x3,'ddd O7') 

      call my_chk_bdry_con(1,nelv,boundaryID,'vvv')
      call my_chk_bdry_con(2,nelt,boundaryIDt,'ttt')

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3

      return
      end
c-----------------------------------------------------------------------
      subroutine setup_etag_bc(etag)
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer hscale, debug_setup
      common /my_idata/ hscale, debug_setup
      real Dp_pbli
      common /my_rdata/ Dp_pbli

      integer etag(1)
      integer ifc,iel,ieg,id_face, id_face2,n
      integer ix,iy,iz,ierr,iglsum
      real zz, zmid, glmin, glmax

      ix = lx1/2 ! some interior point
      iy = ly1/2
      iz = lz1/2

      n = lx1*ly1*lz1*nelt

      ierr = 0
      call izero(etag, lelt)

      do iel = 1, nelt
         ieg = lglel(iel)
         if (ieg .le. 5760*hscale) then      ! PbLi
            etag(iel) = 1

            do ifc = 1, 2*ndim
               id_face = bc(5,ifc,iel,1)

               if     (id_face .eq. 10) then ! inlet
                  boundaryID (ifc,iel) = 1
                  boundaryIDt(ifc,iel) = 1

               elseif (id_face .eq. 11) then ! outlet
                  boundaryID (ifc,iel) = 4
                  boundaryIDt(ifc,iel) = 4

               elseif (id_face .eq. 4) then  ! pipe solid wall
                  boundaryID (ifc,iel) = 7
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 5) then  ! xmax wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 6) then  ! ymin wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 7) then  ! ymax wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 8) then  ! zmin wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 9) then  ! zmax wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               elseif (id_face .eq. 12) then ! baffle wall
                  boundaryID (ifc,iel) = 8
                  boundaryIDt(ifc,iel) = 0
               endif
            enddo

         elseif (ieg .le. 6500*hscale) then  ! water1
            etag(iel) = 2

            do ifc = 1, 2*ndim
               id_face = bc(5,ifc,iel,1)

               if     (id_face .eq. 1) then  ! inlet
                  boundaryID (ifc,iel) = 2
                  boundaryIDt(ifc,iel) = 2

               elseif (id_face .eq. 2) then  ! outlet
                  boundaryID (ifc,iel) = 5
                  boundaryIDt(ifc,iel) = 5

               elseif (id_face .eq. 3) then  ! pipe wall
                  boundaryID (ifc,iel) = 9
                  boundaryIDt(ifc,iel) = 0
               endif
            enddo

         elseif (ieg .le. 7240*hscale) then  ! water2
            etag(iel) = 3

            do ifc = 1, 2*ndim
               id_face = bc(5,ifc,iel,1)
               if     (id_face .eq. 1) then  ! inlet
                  boundaryID (ifc,iel) = 3
                  boundaryIDt(ifc,iel) = 3

               elseif (id_face .eq. 2) then  ! outlet
                  boundaryID (ifc,iel) = 6
                  boundaryIDt(ifc,iel) = 6

               elseif (id_face .eq. 3) then  ! pipe wall
                  boundaryID (ifc,iel) = 10
                  boundaryIDt(ifc,iel) = 0
               endif
            enddo

         elseif (ieg .le. 11992*hscale) then ! solid
            etag(iel) = 4

            do ifc = 1, 2*ndim
               id_face2 = bc(5,ifc,iel,2)

               if     (id_face2 .eq. 4) then  ! enclusure xmax, FW
                  boundaryIDt(ifc,iel) = 7
               elseif (id_face2 .eq. 5) then  ! enclosure ymin
                  boundaryIDt(ifc,iel) = 8
               elseif (id_face2 .eq. 6) then  ! enclosure ymax
                  boundaryIDt(ifc,iel) = 9
               elseif (id_face2 .eq. 7) then  ! enclosure zmin
                  boundaryIDt(ifc,iel) = 10
               elseif (id_face2 .eq. 8) then  ! enclosure zmax
                  boundaryIDt(ifc,iel) = 11
               elseif (id_face2 .eq. 12) then ! enclosure edge (facing x=0)
                  boundaryIDt(ifc,iel) = 12

               elseif (id_face2 .eq. 3) then  ! pipe shell annulus edge (facing xmin)
                  boundaryIDt(ifc,iel) = 13
               elseif (id_face2 .eq. 11) then ! baffle edge (x=0)
                  boundaryIDt(ifc,iel) = 14

               elseif (id_face2 .eq. 13) then ! inlet leg extension outer shell
                  boundaryIDt(ifc,iel) = 15
               endif
            enddo

         else
            ierr = ierr + 1

         endif

      enddo

      ierr = iglsum(ierr,1)
      if (ierr.gt.0) call exitti('Un-recognized! domain!$',ierr)

      return
      end
c-----------------------------------------------------------------------
      subroutine rotate_mesh_aux(bid1,bid2,rotate_vel)
      implicit none
      include 'SIZE'
      include 'TOTAL'

      real fac1_nx, fac1_ny, fac1_nz
      real fac2_nx, fac2_ny, fac2_nz
      real newVecx, newVecy, newVecz
      real xmin, ymid, zmid, glmin, glmax
      integer bid1, bid2, ntot, ntotv, ifld

      logical ifdbg_file, rotate_vel

      ! Rotate mesh to align axis
      ! (optional) rotate velocity from restart file

c     bidv = 1 ! bdry id for Water FW inlet at z+
c     bido = 2 ! bdry id for Water Shield inlet at z-
      ifdbg_file = .false. ! dump files or not

      ! FIXME: only rotate vel if restart file is dumped from mesh-coordinate!!!
      !   if restarting from a rotated vel, turn this off
c      rotate_vel = .true.  

      ntot = lx1*ly1*lz1*nelt
      ntotv = lx1*ly1*lz1*nelv

      ! identify the orientation from inlet
      call get_surface_normal(1,bid1,fac1_nx,fac1_ny,fac1_nz,'bfr v1')
      call get_surface_normal(1,bid2,fac2_nx,fac2_ny,fac2_nz,'bfr v2')
      if (nio.eq.0) write(*,*)'chk-volume bfr',voltm1

      if (ifdbg_file) then
        ifxyo = .true.
        ifvo = .true.
        ifpo = .false.
        ifto = .false.
        call outpost(vx,vy,vz,pr,t,'aaa')
      endif

      ! rotate such that inlet facing (1,0,0)
      newVecx = 1.0
      newVecy = 0.0
      newVecz = 0.0
      call rotate_mesh(fac1_nx, fac1_ny, fac1_nz
     $                ,newVecx, newVecy, newVecz, rotate_vel)

      ! post-rotation chk
      call fix_geom
      call geom_reset(2)
      call get_surface_normal(1,bid1,fac1_nx,fac1_ny,fac1_nz,'aft v1')
      call get_surface_normal(1,bid2,fac2_nx,fac2_ny,fac2_nz,'aft v2')
      if (nio.eq.0) write(*,*)'chk-volume aft',voltm1
      if (ifdbg_file) call outpost(vx,vy,vz,pr,t,'bbb')

c      ! recenter
c      xmin = glmin(xm1,ntotv) ! use fluid mesh
c      ymid = 0.5*(glmax(ym1,ntot) + glmin(ym1,ntot))
c      zmid = 0.5*(glmax(zm1,ntot) + glmin(zm1,ntot))
c      call cadd(xm1, -xmin, ntot)  ! xmin = 0.0
c      call cadd(ym1, -ymid, ntot)  ! ymid = 0.0
c      call cadd(zm1, -zmid, ntot)  ! xmid = 0.0
c      if (nio.eq.0) write(*,*)'chk-recenter',xmin,ymid,zmid
c
c      ! finalize
c      call fix_geom
c      call geom_reset(3)
c      if (ifdbg_file) call outpost(vx,vy,vz,pr,t,'ccc')

      return
      end
c-----------------------------------------------------------------------
      subroutine recenter_mesh(etag,id_pbli)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      integer etag(1), id_pbli, ntot, nxyz, e
      real xmin, ymid, zmid, glmin, glmax, vlmin
      logical ifdbg_file

      ifdbg_file = .false.

      nxyz = lx1*ly1*lz1
      ntot = lx1*ly1*lz1*nelt

      ! recenter
      xmin = 1e30 ! shift x-scale such that min_{(x,y,z) is pbli} x = 0
      do e=1,nelt
        if (etag(e).eq.id_pbli) then
          xmin = min(xmin,vlmin(xm1(1,1,1,e),nxyz))
        endif
      enddo
      xmin = glmin(xmin,1)

      ymid = 0.5*(glmax(ym1,ntot) + glmin(ym1,ntot))
      zmid = 0.5*(glmax(zm1,ntot) + glmin(zm1,ntot))
      call cadd(xm1, -xmin, ntot)  ! xmin = 0.0
      call cadd(ym1, -ymid, ntot)  ! ymid = 0.0
      call cadd(zm1, -zmid, ntot)  ! xmid = 0.0
      if (nio.eq.0) write(*,33)id_pbli,xmin,ymid,zmid
   33 format('chk-recenter eTag=',i3,' shift= ',3e14.6)

      ! finalize
      call fix_geom
      call geom_reset(3)
      if (ifdbg_file) call outpost(vx,vy,vz,pr,t,'ccc')

      return
      end
c-----------------------------------------------------------------------
      subroutine get_surface_center(ifld, bid, xctr, yctr, zctr, s6)
      implicit none
      include 'SIZE'
      include 'GEOM'
      character*6 s6
      integer bdryid(6,lelt), bid
      integer ifld,nel,ia, e, f, ix,iy,iz,kx1,kx2,ky1,ky2,kz1,kz2
      real xavg,yavg,zavg,aa,atot,glsum,xctr,yctr,zctr

      xavg = 0.0
      yavg = 0.0
      zavg = 0.0
      atot = 0.0

      call izero(bdryid, 6*lelt)
      if (ifld.eq.1) then
        nel = nelv
        call icopy(bdryid, boundaryID, 6*nelv)
      else
        nel = nelt
        call icopy(bdryid, boundaryIDt, 6*nelt)
      endif

      do e=1,nel
      do f=1,2*ldim
         if (bdryid(f,e).eq.bid) then

         ia = 0
         call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,f)
         do iz=kz1,kz2
         do iy=ky1,ky2
         do ix=kx1,kx2
            ia = ia + 1
            aa = area(ia,1,f,e)

            xavg = xavg + xm1(ix,iy,iz,e) * aa
            yavg = yavg + ym1(ix,iy,iz,e) * aa
            zavg = zavg + zm1(ix,iy,iz,e) * aa

            atot = atot + aa

         enddo
         enddo
         enddo

         endif
      enddo
      enddo

      atot = glsum(atot,1)
      xavg = glsum(xavg,1) / atot
      yavg = glsum(yavg,1) / atot
      zavg = glsum(zavg,1) / atot

      xctr = xavg
      yctr = yavg
      zctr = zavg

      if (nio.eq.0.AND.s6.ne.'      ') then
         write(*,33) s6,bid,' ',xctr,yctr,zctr
      endif
   33 format('chk-center ',a,' bid=',i3,' avg ',a,3e14.6)
      return
      end
c-----------------------------------------------------------------------
      subroutine get_surface_normal(ifld, bid, nx, ny, nz, s6)
      implicit none
      include 'SIZE'
      include 'GEOM'
      character*6 s6
      integer bdryid(6,lelt), bid
      integer ifld,nel,ia, e, f, ix,iy,iz,kx1,kx2,ky1,ky2,kz1,kz2
      real nx,ny,nz, aa, atot

      real xmin,xmax,xavg
      real ymin,ymax,yavg
      real zmin,zmax,zavg
      real glmin,glmax,glsum

      xmin = 1E30
      xmax = -1E30
      xavg = 0.0
      ymin = 1E30
      ymax = -1E30
      yavg = 0.0
      zmin = 1E30
      zmax = -1E30
      zavg = 0.0
      atot = 0.0

      call izero(bdryid, 6*lelt)
      if (ifld.eq.1) then
        nel = nelv
        call icopy(bdryid, boundaryID, 6*nelv)
      else
        nel = nelt
        call icopy(bdryid, boundaryIDt, 6*nelt)
      endif

      do e=1,nel
      do f=1,2*ldim
         if (bdryid(f,e).eq.bid) then

         ia = 0
         call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,f)
         do iz=kz1,kz2
         do iy=ky1,ky2
         do ix=kx1,kx2
            ia = ia + 1

            nx = unx(ia,1,f,e)
            ny = uny(ia,1,f,e)
            nz = unz(ia,1,f,e)
            aa = area(ia,1,f,e)

            xmin = min(xmin, nx)
            xmax = max(xmax, nx)
            xavg = xavg + nx * aa

            ymin = min(ymin, ny)
            ymax = max(ymax, ny)
            yavg = yavg + ny * aa

            zmin = min(zmin, nz)
            zmax = max(zmax, nz)
            zavg = zavg + nz * aa

            atot = atot + aa

         enddo
         enddo
         enddo

         endif
      enddo
      enddo

      atot = glsum(atot,1)

      xmin = glmin(xmin,1)
      xmax = glmax(xmax,1)
      xavg = glsum(xavg,1) / atot

      ymin = glmin(ymin,1)
      ymax = glmax(ymax,1)
      yavg = glsum(yavg,1) / atot

      zmin = glmin(zmin,1)
      zmax = glmax(zmax,1)
      zavg = glsum(zavg,1) / atot

      nx = xavg
      ny = yavg
      nz = zavg

      if (nio.eq.0.AND.s6.ne.'      ') then
         write(*,32) s6,bid,atot
         write(*,33) s6,bid,'x',xmin,xmax,xavg
         write(*,33) s6,bid,'y',ymin,ymax,yavg
         write(*,33) s6,bid,'z',zmin,zmax,zavg
      endif
   32 format('chk-area   ',a,' bid=',i3,' area',1e14.6)
   33 format('chk-normal ',a,' bid=',i3,' nml-',a,3e14.6)

      if (s6.ne.'      ') then
        call get_surface_center(ifld,bid,xavg,yavg,zavg,s6)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine rotate_mesh(aax,aay,aaz,bbx,bby,bbz,if_updvel)
      implicit none
      include 'SIZE'
      include 'GEOM'
      include 'SOLN'
      integer i
      logical if_updvel
      real aax,aay,aaz,bbx,bby,bbz
      real kx,ky,kz,xx,yy,zz,sin_theta,cos_theta,k_dot_v,tmp

      tmp = sqrt(aax*aax+aay*aay+aaz*aaz)
      aax = aax / tmp
      aay = aay / tmp
      aaz = aaz / tmp

      tmp = sqrt(bbx*bbx+bby*bby+bbz*bbz)
      bbx = bbx / tmp
      bby = bby / tmp
      bbz = bbz / tmp

      ! k = a cross b
      kx = aay*bbz - aaz*bby
      ky = aaz*bbx - aax*bbz
      kz = aax*bby - aay*bbx

      tmp = sqrt(kx*kx+ky*ky+kz*kz)
      kx = kx / tmp
      ky = ky / tmp
      kz = kz / tmp

      cos_theta = aax*bbx+aay*bby+aaz*bbz
      sin_theta = tmp

      do i=1,lx1*ly1*lz1*nelt
         ! vec v
         xx = xm1(i,1,1,1)
         yy = ym1(i,1,1,1)
         zz = zm1(i,1,1,1)

         k_dot_v = kx*xx + ky*yy + kz*zz
         tmp = k_dot_v * (1.0 - cos_theta)

         ! V cos(th) + (k cross v)*sin(th) + k (k dot v) (1-cos(th))
         xm1(i,1,1,1) = xx*cos_theta + (ky*zz-kz*yy)*sin_theta + kx*tmp
         ym1(i,1,1,1) = yy*cos_theta + (kz*xx-kx*zz)*sin_theta + ky*tmp
         zm1(i,1,1,1) = zz*cos_theta + (kx*yy-ky*xx)*sin_theta + kz*tmp
      enddo

      if (if_updvel) then
      do i=1,lx1*ly1*lz1*nelv
         ! vec v
         xx = vx(i,1,1,1)
         yy = vy(i,1,1,1)
         zz = vz(i,1,1,1)

         k_dot_v = kx*xx + ky*yy + kz*zz
         tmp = k_dot_v * (1.0 - cos_theta)

         ! V cos(th) + (k cross v)*sin(th) + k (k dot v) (1-cos(th))
         vx(i,1,1,1) = xx*cos_theta + (ky*zz-kz*yy)*sin_theta + kx*tmp
         vy(i,1,1,1) = yy*cos_theta + (kz*xx-kx*zz)*sin_theta + ky*tmp
         vz(i,1,1,1) = zz*cos_theta + (kx*yy-ky*xx)*sin_theta + kz*tmp
      enddo
      endif

      if (nio.eq.0) then
         write(*,*) 'rot-msh from',aax,aay,aaz
     $            , 'to',bbx,bby,bbz,if_updvel
         write(*,*) 'rot-msh k=',kx,ky,kz,' theta=',sin_theta,cos_theta
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine rotate_mesh_xy(bidv, bido, if_updvel)
      implicit none
      include 'SIZE'
      include 'GEOM'
      include 'SOLN'

      logical if_updvel

      integer bidv, bido, ia, e, f, i
     $      , ix,iy,iz,kx1,kx2,ky1,ky2,kz1,kz2

      real xctr_v, yctr_v, zctr_v, xctr_o, yctr_o, zctr_o
     $   , atot_v, atot_o, aa, glsum, glmax

      real delx, dely, delz, xctr, yctr, zctr
     $   , xx, yy, zz, rr, cos_theta, sin_theta

      call get_surface_center(1,bidv,xctr_v,yctr_v,zctr_v,'      ')
      call get_surface_center(1,bido,xctr_o,yctr_o,zctr_o,'      ')

      if (nio.eq.0) then
        write(*,34) 'inlet ',bidv,xctr_v,yctr_v,zctr_v
        write(*,34) 'outlet',bido,xctr_o,yctr_o,zctr_o
      endif
   34 format('chk-ctr ',a,' bid=',i3,' ',3e14.6)

      delx = xctr_o - xctr_v
      dely = yctr_o - yctr_v
      delz = zctr_o - zctr_v

      xctr = 0.5* (xctr_o + xctr_v) 
      yctr = 0.5* (yctr_o + yctr_v)
      zctr = 0.5* (zctr_o + zctr_v)

      ! vector inlet-outlet is the long axis that will become x axis
      rr = sqrt(delx*delx + dely*dely)
      sin_theta = -dely / rr
      cos_theta =  delx / rr

      do i=1,lx1*ly1*lz1*nelt
         xx = xm1(i,1,1,1)
         yy = ym1(i,1,1,1)
         xx = xx - xctr
         yy = yy - yctr
         xm1(i,1,1,1) = xx * cos_theta - yy * sin_theta
         ym1(i,1,1,1) = xx * sin_theta + yy * cos_theta
      enddo

      if (if_updvel) then
        do i=1,lx1*ly1*lz1*nelv
           xx = vx(i,1,1,1)
           yy = vy(i,1,1,1)
           vx(i,1,1,1) = xx * cos_theta - yy * sin_theta
           vy(i,1,1,1) = xx * sin_theta + yy * cos_theta
        enddo
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine snap_bdry_surface(bid)
      implicit none
      include 'SIZE'
      integer bid
      real nx, ny, nz

      call get_surface_normal(1,bid,nx,ny,nz,'      ')

      ! after rotation, nx = ny = 0
      nx = 0.0
      ny = 0.0

      call proj_bdry_surface(1, bid,nx,ny,nz)
      call fix_geom
      call geom_reset(1)

      return
      end
c-----------------------------------------------------------------------
      subroutine proj_bdry_surface(bid,nx,ny,nz)
      implicit none
      include 'SIZE'
      include 'GEOM'
      integer bid, e, f, kx1,kx2,ky1,ky2,kz1,kz2, ia,ix,iy,iz
      real nx, ny, nz, xtot, ytot, ztot, atot, atmp, xtmp, ytmp, ztmp
      real glsum, glamax
      real xctr_v, yctr_v, zctr_v, xctr_o, yctr_o, zctr_o
      real xx,yy,zz, d, damax

      ! get face center
      xtot = 0.0
      ytot = 0.0
      ztot = 0.0
      atot = 0.0
      do e=1,nelt
      do f=1,2*ldim
        if (boundaryID(f,e).eq.bid) then
          call surface_int(xtmp,atmp,xm1,e,f)
          call surface_int(ytmp,atmp,ym1,e,f)
          call surface_int(ztmp,atmp,zm1,e,f)
          xtot = xtot + xtmp
          ytot = ytot + ytmp
          ztot = ztot + ztmp
        endif
      enddo
      enddo

      atot = glsum(atot,1)
      xctr_o = glsum(xtot,1) / atot
      yctr_o = glsum(ytot,1) / atot
      zctr_o = glsum(ztot,1) / atot

      ! project
      damax = 0.0
      do e=1,nelt
      do f=1,2*ldim
        if (boundaryID(f,e).eq.bid) then
          ia = 0
          call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,f)
          do iz=kz1,kz2
          do iy=ky1,ky2
          do ix=kx1,kx2
             ia = ia + 1
             xx = xm1(ix,iy,iz,e)
             yy = ym1(ix,iy,iz,e)
             zz = zm1(ix,iy,iz,e)

             ! v = x - xo
             xctr_v = xx - xctr_o
             yctr_v = yy - yctr_o
             zctr_v = zz - zctr_o

             ! d = v dot n
             d = xctr_v * nx + yctr_v * ny + zctr_v * nz
             damax = max(damax, abs(d))
             xm1(ix,iy,iz,e) = xx - d * nx
             ym1(ix,iy,iz,e) = yy - d * ny
             zm1(ix,iy,iz,e) = zz - d * nz
          enddo
          enddo
          enddo
        endif
      enddo
      enddo

      damax = glamax(damax,1)

      if (nio.eq.0) then
        write(*,34) bid,nx,ny,nz,xctr_o,yctr_o,zctr_o,damax
      endif
   34 format('chk-pj bid=',i3,' n=',3e14.6,' xc=',3e14.6' d= ',1e14.6)

      return
      end
c---------------------------------------------------------------------
      subroutine tag_bdryid_fluid_common_outlet(etag,tago,tagv,bid)
c     This subroutine go through fluid domain
c     find the interface between
c        a fluid: {e, etag[e]=tagv} and
c        common outlet:{e, etag[e]=tago}
c     and tag boundaryid of that face (in fluid, tagv) to bid
      implicit none
      include 'SIZE'
      include 'TOTAL'
      integer etag(1), tagv, tago, bid, nxyz, e, f
      
      real tmp(lx1,ly1,lz1,lelt), big
      real kx1,kx2,ky1,ky2,kz1,kz2,ix,iy,iz

      if (lx1.lt.3) call exitti('tag bdryid needx lx1>2$',1)

      nxyz = lx1*ly1*lz1
      big = 10000.0 ! larger than multiplicity

      call cfill(tmp, -1.0, nxyz*lelt)
      do e=1,nelv
        if (etag(e).eq.tagv) call cfill(tmp(1,1,1,e), 0.0, nxyz)
        if (etag(e).eq.tago) call cfill(tmp(1,1,1,e), big, nxyz)
      enddo

      ifield = 1
      call dssum(tmp,lx1,ly1,lz1)

      do e=1,nelv
        if (etag(e).eq.tagv) then
          do f=1,2*ldim
            call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,f)
            ix = (kx1+kx2)/2 ! face center, need lx1>2
            iy = (ky1+ky2)/2
            iz = (kz1+kz2)/2
            if (abs(tmp(ix,iy,iz,e) - big).lt.0.5) then
              boundaryID(f,e) = bid
            endif
          enddo
        endif
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine split_etag_using_z(etag,e1,zsep,e2)
c     find elem. with etag(e) == e1, if z < zsep, set etag(e) = e2
      implicit none
      include 'SIZE'
      include 'TOTAL'
      integer etag(1),e1,e2,ix,iy,iz,ie
      real zsep

      ix = lx1/2
      iy = ly1/2
      iz = lz1/2

      do ie=1,nelt
         if (etag(ie).eq.e1) then
            if (zm1(ix,iy,iz,ie).le.zsep) etag(ie) = e2
         endif
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine dump_etag(etag,s3)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'RESTART'

      character*3 s3
      integer etag(1), e, nxyz
      real tmp(lx1*ly1*lz1,lelt)
   
      if (lx1.gt.4) return ! FIXME, nrg
      nxyz = lx1*ly1*lz1

      do e=1,nelt
        call cfill(tmp(1,e), real(etag(e)), nxyz)
      enddo

      ifxyo = .true.
      ifvo = .false.
      ifpo = .false.
      ifto = .true.

c      nrg = 2 ! TODO, bug, this is reset to lxo by io_init
c      ifreguo = .true.
      call outpost(vx,vy,vz,pr,t,s3)

c      nrg = lx1
c      ifreguo = .false.
      ifxyo = .false.
      ifvo = ifflow
      ifpo = ifflow
      ifto = ifheat

      return
      end
c-----------------------------------------------------------------------
      subroutine dump_etag_bc_surface(etag,s3)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      character*3 s3
      integer etag(1), e, f, nxyz, bid1, bid2, iglsum, nel
      real tmp1(lx1*ly1*lz1,lelt), tmp2(lx1*ly1*lz1,lelt)

      nxyz = lx1*ly1*lz1
      call izero(out_mask, lelt)
      call rzero(tmp1,nxyz*nelt)
      call rzero(tmp2,nxyz*nelt)

      do e=1,nelt
         call cfill(tmp1(1,e), real(etag(e)), nxyz)

         do f=1,2*ldim
            bid1 = boundaryID(f,e)
            bid2 = boundaryIDt(f,e)
            if (bid1.gt.0) then
               out_mask(e) = 1
               call facev(tmp2,e,f,real(bid1),lx1,ly1,lz1)
            else if (bid2.gt.0) then
               out_mask(e) = 1
               call facev(tmp2,e,f,real(bid2),lx1,ly1,lz1)
            endif
         enddo
      enddo

      nel = iglsum(out_mask,nelt)
      if (nio.eq.0) write(*,*) 'dump_etag_bc',s3,nel

      ifxyo = .true.
      ifvo = .false.
      ifpo = .true.
      ifto = .true.
      call outpost(vx,vy,vz,tmp2,tmp1,s3)

      call ione(out_mask, lelt) ! restore element fileter
      ifxyo = .false.
      ifvo = ifflow
      ifpo = ifflow
      ifto = ifheat

      return
      end
c-----------------------------------------------------------------------
      subroutine my_cbc_chk(s3)
c     This print types of current BC, counting as well
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer ncbc,lcbc,i,j,e,f,inid,mtype,idummy,ncbc_tmp,ifld,nel
     $      , nfldt
      parameter (lcbc=20) ! max # unique CBC
      integer cbc_count(lcbc),cbc_count_tmp(lcbc)
      character*3 cbc_list(lcbc),cbc_list_tmp(lcbc),cbc3,s3,tag3
      character*2 s2tmp
      logical cbc_in_list

      nfldt = nfield
      if (ifmhd) nfldt = ifldmhd   ! mhd always uses nscal+3, with or without temperature

      do ifld=0,nfldt

        if (ifld.eq.0) then
          tag3='PR '
          nel = nelv
        elseif (ifld.eq.1) then
          tag3='VEL'
          nel = nelv
        elseif (ifmhd.AND.ifld.eq.ifldmhd) then
          tag3='MHD'
          nel = nelv
        elseif (ifld.gt.1) then
          write(s2tmp,'(I2.2)') ifld-2
          tag3='S'//s2tmp
          nel = nelt
        endif

        call izero(cbc_count,lcbc)

        ncbc = 1                 ! # unique CBC
        cbc_list(1) = 'E  ' ! internal BC

        do e=1,nel
        do f=1,2*ldim
          cbc3 = cbc(f,e,ifld)
          cbc_in_list = .false.

          if (cbc3.eq.'E  '.or.cbc3.eq.'   ') then
            cbc_count(1) = cbc_count(1) + 1
            cbc_in_list = .true.
          else
            do i=2,ncbc ! go throught the registered CBC
              if (cbc3.eq.cbc_list(i)) then
                cbc_count(i) = cbc_count(i) + 1
                cbc_in_list = .true.
              endif
            enddo
          endif
          if (.not.cbc_in_list) then
            ncbc = ncbc + 1
            if (ncbc.gt.lcbc)
     $        call exitti('BCchk: Increase lcbc$',ncbc)

            cbc_list(ncbc) = cbc3
            cbc_count(ncbc) = 1
          endif
        enddo
        enddo

        call nekgsync()

        ! All reduce to nid=0
        if (nid.eq.0) then
          do inid=1,np-1
            mtype = inid
            call csend(mtype,idummy,4,inid,0) ! handshake

            call crecv(mtype,ncbc_tmp,4)
            call crecv(mtype,cbc_list_tmp(1),3*ncbc_tmp,0,0)
            call crecv(mtype,cbc_count_tmp(1),4*ncbc_tmp,0,0)

            cbc_count(1) = cbc_count(1)+cbc_count_tmp(1)
            do j=2,ncbc_tmp
              cbc_in_list = .false.
              do i=2,ncbc
                if (cbc_list(i).eq.cbc_list_tmp(j)) then
                  cbc_count(i) = cbc_count(i) + cbc_count_tmp(j)
                  cbc_in_list = .true.
                endif
              enddo
              if (.not.cbc_in_list) then
                ncbc = ncbc + 1
                if (ncbc.gt.lcbc)
     $            call exitti('BCchk: Increase lcbc$',ncbc)

                cbc_list(ncbc) = cbc_list_tmp(j)
                cbc_count(ncbc) = cbc_count_tmp(j)
              endif
            enddo
          enddo
        else
          mtype = nid
          call crecv(mtype,idummy,4) ! ! handshake

          call csend(mtype,ncbc,4,0,0)
          call csend(mtype,cbc_list,3*ncbc,0,0)
          call csend(mtype,cbc_count,4*ncbc,0,0)
        endif

        call nekgsync()

        ! print
        if (nid.eq.0) then
          do i=1,ncbc
            write(6,41) s3,ifld,tag3,cbc_list(i),cbc_count(i)
          enddo
        endif

      enddo ! ifld

   41 format(a3,' BC: 'i3,' ',a3,a5,i10)

      return
      end
c-----------------------------------------------------------------------
      subroutine my_bdid_chk(s3)
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer nbid,lcbc,bid,i,j,e,f,inid,mtype,idummy,nbid_tmp,nel,ifld
      parameter (lcbc=40) ! max # unique CBC
      integer bid_count(lcbc),bid_count_tmp(lcbc)
      integer bid_list(lcbc),bid_list_tmp(lcbc),cbc3
      logical bid_in_list
      character*3 s3
      character*5 tag5

      ! pass 1: bdid
      do ifld=1,2

        nel = nelv
        tag5 = "bdidv" 
        if (ifld.eq.2) then
          nel=nelt
          tag5 = "bdidt"
        endif
        
        call izero(bid_count,lcbc)
        
        nbid = 1         ! # unique CBC
        bid_list(1) = 0 ! internal BC
        
        do e=1,nel
        do f=1,2*ldim
          
          bid = boundaryID(f,e)
          if (ifld.eq.2) bid = boundaryIDt(f,e)
          
          bid_in_list = .false.
          if (bid.eq.0) then
            bid_count(1) = bid_count(1) + 1
            bid_in_list = .true.
          else 
            do i=2,nbid ! go throught the registered CBC
              if (bid.eq.bid_list(i)) then  
                bid_count(i) = bid_count(i) + 1
                bid_in_list = .true.
              endif
            enddo
          endif
          if (.not.bid_in_list) then
            nbid = nbid + 1
            if (nbid.gt.lcbc)
     $        call exitti('BCchk: Increase lcbc$',nbid)
            
            bid_list (nbid) = bid
            bid_count(nbid) = 1
          endif
        enddo
        enddo
      
        call nekgsync()
      
        ! All reduce to nid=0
        if (nid.eq.0) then
          do inid=1,np-1
            mtype = inid
            call csend(mtype,idummy,isize,inid,0) ! handshake
            
            call crecv(mtype,nbid_tmp,isize)
            call crecv(mtype,bid_list_tmp(1), isize*nbid_tmp)
            call crecv(mtype,bid_count_tmp(1),isize*nbid_tmp)
            
            bid_count(1) = bid_count(1)+bid_count_tmp(1)
            do j=2,nbid_tmp 
              bid_in_list = .false.
              do i=2,nbid
                if (bid_list(i).eq.bid_list_tmp(j)) then
                  bid_count(i) = bid_count(i) + bid_count_tmp(j)
                  bid_in_list = .true.
                endif
              enddo
              if (.not.bid_in_list) then
                nbid = nbid + 1
                if (nbid.gt.lcbc)
     $            call exitti('BCchk: Increase lcbc$',nbid)
                
                bid_list(nbid) = bid_list_tmp(j)
                bid_count(nbid) = bid_count_tmp(j)
              endif
            enddo
          enddo
        else
          mtype = nid
          call crecv(mtype,idummy,isize) ! ! handshake

          call csend(mtype,nbid,isize,0,0)
          call csend(mtype,bid_list,isize*nbid,0,0)
          call csend(mtype,bid_count,isize*nbid,0,0)
        endif

        call nekgsync()

        ! print
        if (nid.eq.0) then
          do i=1,nbid
            write(6,41) s3,tag5,bid_list(i),bid_count(i)
          enddo
        endif

      enddo !ifld

   41 format(a3,' BCid: ',a5,i5,i10)
      return
      end
c-----------------------------------------------------------------------
      subroutine my_chk_bdry_con(ifld,nel,bdryid,s3)
      implicit none
      include 'SIZE'
      include 'TSTEP' ! ifield
c      include 'TOTAL'

      integer ifld,nel,bdryid(2*ldim,lelt)
      character*3 s3

      real tmp(lx1,ly1,lz1,lelt)
      integer maxbdry, ibc, nbc, nbcface0, nbcface1
      integer  e, f, ix, iy, iz
      parameter(maxbdry=99)
      integer nbdrys(maxbdry),iwork(maxbdry)
      integer iglsum,iglmax

      integer ix_fctr(6), iy_fctr(6), iz_fctr(6), idd
      parameter(idd=ldim-1)
      data ix_fctr /  2,lx1,  2,  1,  2,  2/
      data iy_fctr /  1,  2,ly1,  2,  2,  2/
      data iz_fctr /idd,idd,idd,idd,  1,lz1/

      ifield=ifld

      call rone(tmp,lx1*ly1*lz1*lelt)
      call izero(nbdrys,maxbdry)
      call dssum(tmp,lx1,ly1,lz1)

      nbcface0 = 0
      nbcface1 = 0

      nbc = 0
      do e=1,nel
      do f=1,2*ldim

        ibc = bdryid(f,e)
        if (ibc.gt.0) then
          nbdrys(ibc) = nbdrys(ibc) + 1
          nbcface0 = nbcface0 + 1
          nbc = max(nbc,ibc)
        endif

        ix = ix_fctr(f)
        iy = iy_fctr(f)
        iz = iz_fctr(f)
        if (tmp(ix,iy,iz,e).lt.1.5) nbcface1 = nbcface1 + 1

      enddo
      enddo
      nbcface0 = iglsum(nbcface0,1)
      nbcface1 = iglsum(nbcface1,1)

      nbc = iglmax(nbc,1)
      call igop(nbdrys,iwork,'+  ',nbc)

      ! if any one of nbdrys(ibc) is zero, there is an error in connecivity or bc
      ! Also, nbcface0 shoud be the same as nbcface1
      if (nio.eq.0) then
        do ibc=1,nbc
          write(*,*)'chk bdryidt',s3,ibc,nbdrys(ibc)
        enddo
        write(*,*)'chk bdryidt',s3,' total',nbc,nbcface0,nbcface1
      endif

      return
      end
c---------------------------------------------------------------------
      subroutine chk_minmax(u, nel, s6)
      implicit none
      include 'SIZE'
      real u(1), umin, umax, glmin, glmax
      character*6 s6
      integer n, nel

      n = lx1*ly1*lz1*nel

      umin = glmin(u, n)
      umax = glmax(u, n)
      if (nio.eq.0) then
         write(*,32) s6,umin,umax
      endif

   32 format('chk-minmax ',a,2e14.6)
      return
      end
c---------------------------------------------------------------------
      subroutine chk_domain_minmax(s3)
      implicit none
      include 'SIZE'
      include 'GEOM'
      character*3 s3

      call chk_minmax(xm1, nelv, s3//' xv')
      call chk_minmax(ym1, nelv, s3//' yv')
      call chk_minmax(zm1, nelv, s3//' zv')
      call chk_minmax(xm1, nelt, s3//' xt')
      call chk_minmax(ym1, nelt, s3//' yt')
      call chk_minmax(zm1, nelt, s3//' zt')

      return
      end
c---------------------------------------------------------------------
      subroutine chk_etag_glsum(u, etag, id, s6)
      implicit none
      include 'SIZE'
      real u(lx1*ly1*lz1,1), usum, glsum, vlsum
      character*6 s6
      integer etag(1), id, nxyz, e

      nxyz = lx1*ly1*lz1

      usum = 0.0
      do e=1,nelt
        if (etag(e).eq.id) then
          usum = usum + vlsum(u(1,e),nxyz)
        endif
      enddo
      usum = glsum(usum,1)

      if (nio.eq.0) then
         write(*,32) s6,id,usum
      endif

   32 format('chk-eTagSum ',a,' etag=',i3,1e14.6)
      return
      end
c---------------------------------------------------------------------
      subroutine chk_etag_minmax(u, etag, id, s6)
      implicit none
      include 'SIZE'
      real u(lx1*ly1*lz1,1), umin, umax, glmin, glmax, vlmin, vlmax
      character*6 s6
      integer etag(1), id, nxyz, e

      nxyz = lx1*ly1*lz1

      umin = 1e30
      umax = -1e30
      do e=1,nelt
        if (etag(e).eq.id) then
          umin = min(umin, vlmin(u(1,e),nxyz))
          umax = max(umax, vlmax(u(1,e),nxyz))
        endif
      enddo
      umin = glmin(umin,1)
      umax = glmax(umax,1)

      if (nio.eq.0) then
         write(*,32) s6,id,umin,umax
      endif

   32 format('chk-minmax ',a,' etag=',i3,2e14.6)
      return
      end
c---------------------------------------------------------------------
      subroutine chk_domain_etag_minmax(etag,s3) ! measure min/max for vis
      implicit none
      include 'SIZE'
      include 'GEOM'
      character*3 s3
      integer iglmax, etag(1), i, ndomain

      ndomain = iglmax(etag,nelt)
      do i=1,ndomain
        call chk_etag_minmax(xm1, etag, i, s3//' xd')
        call chk_etag_minmax(ym1, etag, i, s3//' yd')
        call chk_etag_minmax(zm1, etag, i, s3//' zd')
      enddo

      return
      end
c---------------------------------------------------------------------
      subroutine chk_domain_etag_volume(etag,s3) ! measure vol
      implicit none
      include 'SIZE'
      include 'MASS' ! bm1
      character*3 s3
      integer iglmax, etag(1), i, ndomain

      ndomain = iglmax(etag,nelt)
      do i=1,ndomain
        call chk_etag_glsum(bm1, etag, i, s3//'vol')
      enddo

      return
      end
c---------------------------------------------------------------------
